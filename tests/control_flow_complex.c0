int classify(int x) {
  if (x < 0) {
    if (x < 100) {
      return 0 - 2;
    } else {
      return 0 - 1;
    }
  } else {
    if (x == 0) {
      return 0;
    } else {
      if (x > 100) {
        return 2;
      } else {
        return 1;
      }
    }
  }
}

int main() {
  int sum = 0;
  for (int i = 0 - 200; i <= 200; i += 1) {
    sum += classify(i);
  }
  return sum;
}
