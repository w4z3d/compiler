extern void print_char(char x);
extern void println();

struct Args {
  int count;
  char *[] arguments;
};

void print_string(char *str) {
  for (int i = 0; str[i] != '\0'; i++) {
    print_char(str[i]);
  }
  println();
}

int main(int argc, char **argv) {
  Args *arguments = alloc(struct Args);
  arguments->arguments = alloc_array(char *, 100);
  arguments->count = argc;
  for (int i = 0; i < argc; i++) {
    arguments->arguments[i] = argv[i];
  }

  for (int i = 0; i < arguments->count; i++) {
    print_string(arguments->arguments[i]);
  }

  return arguments->count;
}
