void sort(int[] arr, int len) {
  for (int i = 0; i < len - 1; i += 1) {
    for (int j = 0; j < len - i - 1; j += 1) {
      if (arr[j] > arr[j + 1]) {
        int temp = arr[j];
        arr[j] = arr[j + 1];
        arr[j + 1] = temp;
      }
    }
  }
}

int main() {
  int[] a = alloc_array(int, 5);
  a[0] = 5;
  a[1] = 3;
  a[2] = 1;
  a[3] = 4;
  a[4] = 2;
  sort(a, 5);
  int result = 0;
  for (int i = 0; i < 5; i += 1) {
    result = result * 10 + a[i];
  }
  return result;
}
