  S = cp(int_min(), cp(-12, cp(0, cp(16, cp(22, cp(int_max(), dp(E)))))));
  insert(S, int_max());
  if (nk(ck(ck(ck(ck(ck(ck(S,int_min()),-12),0),16),22),int_max())) != NULL)
