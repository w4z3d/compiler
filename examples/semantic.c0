int main() {
  int x = 100 + 200 * 300 / 100;
  for (int i = 0; i < 100; i++) {
    for(int j = 1; j < i; j++) {
      x = j * i;
      if (x < 100) {
        x++;
        return x;
      }
    }
  }

  for (int i = 0; i < 100; i++) {
    for(int j = 1; j < i; j++) {
      x = j * i;
      if (x < 100) {
        x++;
      }
    }
  }
  return x;
}
